# Biao V2 NAS 部署配置模板
# 复制为 .env 并填入真实值：cp .env.example .env
# 或使用 install.sh 自动生成

# API 认证 token（Worker 连接时使用）
# 生成命令：openssl rand -hex 48
BIAO_API_TOKEN=your_api_token_here

# V2 凭据加密密钥
# 生成命令：openssl rand -hex 48
BIAO_V2_CREDENTIAL_KEY=your_credential_key_here

# V2 feature flags（默认全关，按 §23.1 顺序开启）
# 启用顺序：DISTRIBUTED_MODE → ARTIFACTS → NODE_RUNTIME → GIT_DELIVERY → MERGE_QUEUE
BIAO_DISTRIBUTED_MODE=0
BIAO_V2_ARTIFACTS=0
BIAO_V2_NODE_RUNTIME=0
BIAO_V2_GIT_DELIVERY=0
BIAO_V2_MERGE_QUEUE=0
