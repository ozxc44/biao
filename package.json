{
  "name": "@vtp/biao",
  "version": "0.1.0",
  "description": "Local-first multi-agent PM, scheduling, ownership and acceptance platform",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozxc44/biao.git"
  },
  "homepage": "https://github.com/ozxc44/biao#readme",
  "bugs": {
    "url": "https://github.com/ozxc44/biao/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "web/dist",
    "bin",
    "bootstrap.sh",
    "scripts/bootstrap.mjs",
    "scripts/redis-probe.mjs",
    "scripts/pm-agent.mjs",
    "scripts/codex-pm-agent.mjs",
    "scripts/supervisor.mjs",
    "scripts/install.sh",
    "docs",
    "AGENTS.md",
    "README.md"
  ],
  "bin": {
    "biao": "bin/biao.js",
    "biao-worker": "bin/biao-worker.js",
    "cli-worker": "bin/cli-worker.js",
    "codex-worker": "bin/codex-worker.js",
    "kimi-worker": "bin/kimi-worker.js"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup": "node scripts/bootstrap.mjs",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc && node scripts/copy-assets.mjs",
    "build:web": "npm --prefix web run build",
    "start": "node dist/server/main.js",
    "dev": "tsx src/server/main.ts",
    "test": "vitest run",
    "test:web": "npm --prefix web test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
