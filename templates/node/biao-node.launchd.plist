<?xml version="1.0" encoding="UTF-8"?>
<!--
  biao-node macOS LaunchDaemon 模板（Phase 3 · §10.2）

  占位符替换说明（安装时由运维或安装脚本替换，替换后不得再残留任何占位符）：
    __NODE_BIN__            Node.js 运行时绝对路径，如 /usr/local/bin/node
    __BIAO_NODE_JS__        bin/biao-node.js 绝对路径
    __BIAO_NODE_CONFIG__    biao-node.config.json 绝对路径
    __BIAO_NODE_STATE_DIR__ 节点状态/日志目录（daemon 用户可写）
    __BIAO_NODE_USER__      运行用户（建议专用低权账号；凭据文件归该用户 0600）

  安装步骤（中文 runbook：docs/runbooks/biao-node.md）：
    1. 替换占位符后校验：plutil -lint com.biao.node.plist
    2. 安装：sudo cp com.biao.node.plist /Library/LaunchDaemons/ &&
             sudo chown root:wheel /Library/LaunchDaemons/com.biao.node.plist &&
             sudo chmod 644 /Library/LaunchDaemons/com.biao.node.plist
    3. 加载：sudo launchctl bootstrap system /Library/LaunchDaemons/com.biao.node.plist
    4. 排空/升级：biao-node drain --config <配置> && sudo launchctl bootout system/com.biao.node
  KeepAlive 语义：非零退出（如 fencing exit 3）自动重启并注册新 session
  generation；drain 收口后以 0 退出、不重启（升级窗口即由此而来）。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.biao.node</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__BIAO_NODE_JS__</string>
        <string>run</string>
        <string>--config</string>
        <string>__BIAO_NODE_CONFIG__</string>
    </array>

    <key>UserName</key>
    <string>__BIAO_NODE_USER__</string>

    <key>WorkingDirectory</key>
    <string>__BIAO_NODE_STATE_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- 非零退出才重启；drain（exit 0）不重启，保留升级窗口 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- 崩溃重启节流，避免 fencing 循环打爆控制面 -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__BIAO_NODE_STATE_DIR__/biao-node.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__BIAO_NODE_STATE_DIR__/biao-node.stderr.log</string>
</dict>
</plist>
